WEB_BIND=127.0.0.1
WEB_PORT=8080
# Android dependency repository: auto tries offline first; 0 allows network, 1 requires full cache.
ANDROID_BUILD_OFFLINE=auto
# TURN bytes per second per session, enough for voice and screen sharing.
TURN_MAX_BPS=512000
# Populate all three once with scripts/enable-calls.sh or build-android.sh --enable-calls.
TURN_HOST=
TURN_EXTERNAL_IP=
# Local address for TURN relay sockets; empty uses TURN_EXTERNAL_IP. Must exist on the TURN host.
TURN_RELAY_IP=
TURN_SECRET=
# Optional dedicated TURN TLS endpoint; same TURN_SECRET, separate host/IP from HTTPS.
TURN_TLS_URLS=
# Example: turns:turn.example.com:443?transport=tcp
# Set your real domain for HTTPS and desktop/mobile builds:
CHAT_DOMAIN=chat.example.com
VITE_API_URL=https://chat.example.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,https://localhost,app://volna,https://chat.example.com

# Administrator: separate SMS login, HTTPS on https://CHAT_DOMAIN:8998.
ADMIN_PHONE=+79681411241
# Empty selects the address above automatically.
ADMIN_PUBLIC_URL=

# Phone login: the provider key is used only by the server.
# Comma-separated verified APK signing hashes; build-android.sh fills this automatically.
ANDROID_SMS_APP_HASHES=
NOTIFICORE_API_KEY=
NOTIFICORE_ORIGINATOR=
# SMS provider: initial default; saved admin-panel selection takes precedence.
SMS_PROVIDER=notificore
SMS_GATEWAY_URL=http://188.128.67.14:3825/default/en_US/send.html
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_LINE=4
# Last reference already used: 4 makes the next request ext_id_005.
SMS_REFERENCE_START=0
# Trust X-Real-IP only behind the supplied nginx gateway.
AUTH_TRUST_PROXY=1
PUBLIC_BASE_URL=https://volna.lknet.ru

# Free local Whisper speech recognition (no cloud API key or per-minute billing).
# The model is downloaded into a persistent Docker volume on first start.
# Fast defaults for CPU: Russian language, base model, single beam, int8.
# Full local quality profile; large weights and float32 need sufficient RAM/CPU.
WHISPER_MODEL=large-v3
# Cached fallback only, never downloads an extra model; off disables fallback.
WHISPER_FALLBACK_MODEL=base
WHISPER_CPU_THREADS=8
WHISPER_COMPUTE_TYPE=float32
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=ru

# Static custom emoji: limits and explicit moderation role (comma-separated user IDs).
EMOJI_PACK_MAX_ITEMS=200
EMOJI_REACTIONS_PER_USER=20
EMOJI_REACTION_TYPES=100
EMOJI_MODERATOR_USER_IDS=
