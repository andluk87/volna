#include <windows.h>
IDI_ICON1 ICON "@VOLNA_ICON@"
1 VERSIONINFO
 FILEVERSION 0,1,3,0
 PRODUCTVERSION 0,1,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Volna"
   VALUE "FileDescription", "Volna Desktop Native"
   VALUE "FileVersion", "0.1.3"
   VALUE "InternalName", "VolnaDesktop"
   VALUE "OriginalFilename", "VolnaDesktop.exe"
   VALUE "ProductName", "Volna Desktop Native"
   VALUE "ProductVersion", "0.1.3"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
